#!/bin/sh
# Cheap prefilter in front of `devlock hook`.
#
# The guard has to run on every Bash tool call in every session, but it only has
# anything to say about commands that reach hardware — and starting Python costs
# ~55 ms while a shell `case` costs ~2 ms. A guard that taxes every unrelated
# `git status` is a guard the user turns off, and a guard that is off protects
# no devices. So: match cheaply, and only pay for the real check when it matters.
#
# Fails open on every path, like the tool it fronts.
set -u
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEVLOCK="$DIR/devlock"
[ -x "$DEVLOCK" ] || exit 0

EVENT=${1:-}
[ -n "$EVENT" ] || exit 0

if [ "$EVENT" != "pre-bash" ]; then
    exec "$DEVLOCK" hook "$EVENT"
fi

payload=$(cat 2>/dev/null) || exit 0

# Normalise before matching, for two reasons.
#
# The prefilter globs the raw JSON while devlock tokenizes it, so the two
# disagreed about what the command was: `a''db -s FOO shell ls` runs as adb, and
# devlock denies it, but the raw text contains no "adb" so the prefilter let it
# past — a one-character bypass of the thing it fronts. Deleting quote and
# escape characters makes the probe agree with what the shell will execute.
#
# Turning JSON punctuation into spaces then lets the patterns below use word
# boundaries, so short tool names like `pio` and `cu` can be matched without
# also firing on "accumulate" or "audio".
probe=$(printf '%s' "$payload" | tr -d "\\\\'\"" | tr ',:{}[]()' '        ')

case " $probe " in
    # Anything that could open, flash, drive or enumerate a device.
    *adb*|*fastboot*|*scrcpy*|*esptool*|*idf.py*|*platformio*|*avrdude*|\
    *mpremote*|*ampy*|*rshell*|*picocom*|*minicom*|*xcrun*|*ios-deploy*|\
    *devicectl*|*/dev/tty*|*/dev/serial/*|*\ pio\ *|*\ cu\ *|*\ screen\ *)
        printf '%s' "$payload" | "$DEVLOCK" hook pre-bash
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
